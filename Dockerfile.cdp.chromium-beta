FROM ghcr.io/iftekharahmedid/translucid-neko-drm:chromium-latest

RUN if command -v node >/dev/null 2>&1 && node --version | grep -Eq '^v2[2-9]\.'; then \
      node --version; \
    else \
      curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
      apt-get install -y --no-install-recommends nodejs && \
      node --version && \
      rm -rf /var/lib/apt/lists/*; \
    fi

COPY translucid-browser-use-cdp-bridge/ /opt/translucid/browser-use-cdp-bridge/
COPY translucid-extension/ /opt/translucid/extension/

RUN chown -R neko:neko /opt/translucid/browser-use-cdp-bridge /opt/translucid/extension
